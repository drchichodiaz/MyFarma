// Esquema de MyFarma (ver PLAN.md → Modelo de datos).
// Extensiones (postgis, pg_trgm, unaccent) en la migración 0000_extensions.
// Las columnas geográficas `location` se llenan con un trigger a partir de lat/lng
// (ver migración de la F1), porque Prisma no escribe tipos PostGIS directamente.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StockStatus {
  AVAILABLE // Hay
  LOW // Quedan pocas
  OUT // No hay
}

/// Foto de un reporte: el worker la procesa (sin EXIF/GPS) antes de mostrarla.
enum PhotoStatus {
  PENDING // subida, esperando al worker
  READY // variantes AVIF/WebP publicadas en img.myfarma.net
  FAILED // no se pudo procesar
  HIDDEN // ocultada por un admin
}

/// Por dónde avisar una alerta.
enum Channel {
  EMAIL
  PUSH
}

enum Role {
  USER
  ADMIN
}

/// Usuario. Lo crea Auth.js al entrar con Google o con enlace por correo.
/// En público solo se muestra el nombre + inicial del apellido (ver src/lib/people.ts).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(USER)
  /// Bloqueado por moderación: puede buscar, pero no reportar, confirmar ni crear alertas.
  blockedAt     DateTime? @map("blocked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts          Account[]
  sessions          Session[]
  reports           Report[]
  confirmations     Confirmation[]
  alerts            Alert[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

/// Cuenta de un proveedor externo (Google). Modelo de Auth.js.
model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Sesión guardada en la base de datos (la cookie solo lleva el token). Modelo de Auth.js.
model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Token del enlace mágico por correo. Modelo de Auth.js.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

/// Condición o enfermedad para navegar por categorías (Artritis reumatoide, Diabetes…).
model Condition {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  name  String
  /// Token de color del cuadro pastel: teal | yellow | salmon | pink | blue | sun | lime
  color String
  /// Nombre del ícono en el set de la UI.
  icon  String
  sort  Int    @default(0)

  medications MedicationCondition[]

  @@map("conditions")
}

/// Un medicamento es principio activo + concentración + presentación.
/// "Metotrexato 2.5 mg tabletas" y "Metotrexato 25 mg/mL inyectable" son registros distintos.
model Medication {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  activeIngredient String   @map("active_ingredient")
  strength         String
  form             String
  pack             String?
  requiresRx       Boolean  @default(true) @map("requires_rx")
  scarceInCss      Boolean  @default(false) @map("scarce_in_css")
  /// Marcas comerciales y nombres alternativos, para la búsqueda.
  aliases          String[]
  /// Texto normalizado (sin acentos, minúsculas) con nombre, concentración, alias y condiciones.
  /// Índice GIN trigram para búsqueda difusa.
  searchText       String   @map("search_text")

  conditions   MedicationCondition[]
  availability Availability[]
  reports      Report[]
  alerts       Alert[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "medications_search_trgm")
  @@index([scarceInCss])
  @@map("medications")
}

model MedicationCondition {
  medicationId Int @map("medication_id")
  conditionId  Int @map("condition_id")

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  condition  Condition  @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@id([medicationId, conditionId])
  @@index([conditionId])
  @@map("medication_conditions")
}

/// Cadena de farmacias.
model Chain {
  id      Int     @id @default(autoincrement())
  slug    String  @unique
  name    String
  website String?
  /// Token de color del distintivo de la cadena.
  color   String

  branches Branch[]

  @@map("chains")
}

/// Sucursal de una cadena, con su ubicación.
model Branch {
  id       Int                                   @id @default(autoincrement())
  slug     String                                @unique
  chainId  Int                                   @map("chain_id")
  /// Barrio o nombre corto ("Los Pueblos").
  name     String
  address  String
  phone    String?
  /// Texto de horario legible ("Lun–Dom 7:00–22:00").
  hours    String?
  lat      Float
  lng      Float
  /// geography(Point,4326) calculada por trigger desde lat/lng. Índice GIST.
  location Unsupported("geography(Point,4326)")?
  /// false = dato de ejemplo o sin confirmar.
  verified Boolean                               @default(false)

  chain        Chain          @relation(fields: [chainId], references: [id])
  availability Availability[]
  reports      Report[]

  @@index([location], type: Gist)
  @@index([chainId])
  @@map("branches")
}

/// Un reporte de un paciente: "en tal sucursal, tal medicamento, hay / quedan pocas / no hay".
model Report {
  id           String       @id @default(cuid())
  userId       String?      @map("user_id")
  medicationId Int          @map("medication_id")
  branchId     Int          @map("branch_id")
  status       StockStatus
  /// Precio en centavos de balboa (B/. 15.20 → 1520).
  priceCents   Int?         @map("price_cents")
  /// PENDING: clave del original en el bucket privado. READY: prefijo de las variantes ("r/<id>").
  photoKey     String?      @map("photo_key")
  photoStatus  PhotoStatus? @map("photo_status")
  /// Tamaño de la variante más grande, para reservar el espacio (sin saltos al cargar).
  photoWidth   Int?         @map("photo_width")
  photoHeight  Int?         @map("photo_height")
  hidden       Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  medication    Medication      @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  confirmations Confirmation[]
  deliveries    AlertDelivery[]

  @@index([branchId, medicationId, createdAt(sort: Desc)])
  @@index([medicationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([photoStatus])
  @@index([createdAt(sort: Desc)])
  @@map("reports")
}

/// "Sí había / No había" de otra persona sobre un reporte. Un voto por usuario por reporte.
model Confirmation {
  id        String   @id @default(cuid())
  reportId  String   @map("report_id")
  userId    String   @map("user_id")
  agrees    Boolean
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("confirmations")
}

/// Estado actual de un medicamento en una sucursal. Se recalcula con cada reporte,
/// para que la búsqueda no tenga que recorrer el historial.
model Availability {
  branchId      Int         @map("branch_id")
  medicationId  Int         @map("medication_id")
  status        StockStatus
  priceCents    Int?        @map("price_cents")
  confirmedAt   DateTime    @map("confirmed_at")
  /// Cuántas personas confirmaron este estado desde el último cambio.
  confirmations Int         @default(1)
  lastReportId  String?     @map("last_report_id")

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@id([branchId, medicationId])
  @@index([medicationId, status])
  @@map("availability")
}

/// "Avísame cuando haya X a menos de N km de aquí".
/// `center` (geography) la llena un trigger desde lat/lng, igual que en branches.
model Alert {
  id             String                                @id @default(cuid())
  userId         String                                @map("user_id")
  medicationId   Int                                   @map("medication_id")
  lat            Float
  lng            Float
  center         Unsupported("geography(Point,4326)")?
  /// Cómo se muestra el centro: "tu ubicación", "Los Pueblos"…
  placeLabel     String                                @map("place_label")
  radiusKm       Float                                 @map("radius_km")
  channels       Channel[]
  active         Boolean                               @default(true)
  /// Máximo un aviso cada 12 h por alerta.
  lastNotifiedAt DateTime?                             @map("last_notified_at")
  createdAt      DateTime                              @default(now()) @map("created_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication      @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  @@index([center], type: Gist)
  @@index([medicationId, active])
  @@index([userId])
  @@map("alerts")
}

/// Un aviso enviado (o intentado). Único por alerta y reporte: los reintentos no duplican.
model AlertDelivery {
  id        String    @id @default(cuid())
  alertId   String    @map("alert_id")
  reportId  String    @map("report_id")
  /// Canales que sí salieron.
  sent      Channel[]
  createdAt DateTime  @default(now()) @map("created_at")

  alert  Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([alertId, reportId])
  @@index([reportId])
  @@map("alert_deliveries")
}

/// Suscripción Web Push de un navegador (un usuario puede tener varias: celular y computadora).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
