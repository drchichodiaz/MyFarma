# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# env: se versiona solo la plantilla
!.env.example

# Prisma client generado
/src/generated/

# referencias de diseño de terceros (no se versionan)
/Diseño*.webp

# skills de agentes descargadas por `prisma init` (herramientas locales, no son parte de la app)
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# Playwright
/test-results/
/playwright-report/

# caché de scripts (OpenStreetMap)
/.cache

# Lighthouse CI
/.lighthouseci
