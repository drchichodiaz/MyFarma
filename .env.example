# Copia este archivo a .env y ajusta los valores.

# Postgres + PostGIS (docker compose: puerto 5433)
DATABASE_URL="postgresql://myfarma:myfarma@localhost:5433/myfarma?schema=public"

# Redis (docker compose: puerto 6380)
REDIS_URL="redis://localhost:6380"

# Correo (Mailpit en desarrollo: http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
EMAIL_FROM="MyFarma <no-reply@myfarma.local>"
SMTP_USER=""
SMTP_PASS=""

# Auth.js — genera AUTH_SECRET con: openssl rand -base64 32
AUTH_SECRET=""
# Opcional en local: sin estas dos, solo se entra por correo (Mailpit).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Fotos (F2b): bucket privado de originales + bucket público de variantes
R2_ACCOUNT_ID=""
R2_PHOTOS_ACCESS_KEY_ID=""
R2_PHOTOS_SECRET_ACCESS_KEY=""
R2_UPLOADS_BUCKET="myfarma-uploads"
R2_PHOTOS_BUCKET="myfarma-photos"
PHOTOS_PUBLIC_URL="https://img.myfarma.net"
# Worker → app para refrescar el caché cuando una foto queda lista: openssl rand -base64 24
INTERNAL_SECRET=""

# Alertas (F3). Claves VAPID: node -e "console.log(require('web-push').generateVAPIDKeys())"
PUBLIC_URL="http://localhost:3000"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@myfarma.net"

# Correos que quedan como admin al entrar (separados por coma)
ADMIN_EMAILS=""
