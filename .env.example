# Copia este archivo a .env y ajusta los valores.

# Postgres + PostGIS (docker compose: puerto 5433)
DATABASE_URL="postgresql://myfarma:myfarma@localhost:5433/myfarma?schema=public"

# Redis (docker compose: puerto 6380)
REDIS_URL="redis://localhost:6380"

# Correo (Mailpit en desarrollo: http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
EMAIL_FROM="MyFarma <no-reply@myfarma.local>"
